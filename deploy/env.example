# deploy/.env: made by setup.sh, which fills the secrets and addresses. Edit keys here.

# Public addresses. setup.sh uses free sslip.io names for the server's IP; any domain works.
API_DOMAIN=
SIM_DOMAIN=
DASHBOARD_DOMAIN=

# Generated by setup.sh
POSTGRES_PASSWORD=
S3_SECRET=
PANKH_SECRET_KEY=
PANKH_DOCUMENT_MASTER_KEY=
PANKH_PHONE_WEBHOOK_TOKEN=
PANKH_VOICE_SERVICE_TOKEN=

# Public demo: sign-in codes for the synthetic demo numbers are shown in the app.
PANKH_DEMO_SIGN_IN=true

# Real SMS sign-in: the Firebase project ID (Firebase console, Project settings)
PANKH_FIREBASE_PROJECT_ID=

# Voice (optional; start with: docker compose --profile voice up -d)
PANKH_SARVAM_API_KEY=
PANKH_LIVEKIT_URL=
PANKH_LIVEKIT_API_KEY=
PANKH_LIVEKIT_API_SECRET=

# JAGO on AWS Bedrock (optional). Use an IAM access key that can only call Bedrock.
PANKH_BEDROCK_MODEL_ID=
PANKH_AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
