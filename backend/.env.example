# Copy to backend/.env (which git ignores) and fill in. Never commit real keys.

# JAGO's language model on Gemini (aistudio.google.com/apikey)
PANKH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PANKH_LLM_MODEL=gemini-3.5-flash-lite
PANKH_LLM_API_KEY=

# Or AWS Bedrock (credentials from this AWS profile); when set, it is used instead
# PANKH_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# PANKH_AWS_PROFILE=rudoneyet
# PANKH_AWS_REGION=ap-south-1

# Real SMS sign-in: the Firebase project ID (Firebase console, Project settings)
PANKH_FIREBASE_PROJECT_ID=

# Speech for the voice agent (Sarvam AI dashboard, API keys)
PANKH_SARVAM_API_KEY=

# LiveKit Cloud project (Settings, Keys)
PANKH_LIVEKIT_URL=wss://your-project.livekit.cloud
PANKH_LIVEKIT_API_KEY=
PANKH_LIVEKIT_API_SECRET=
